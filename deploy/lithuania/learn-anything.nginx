# Only this site's vhost is managed here. Keep other projects and ACME routes intact.
server {
    listen 80;
    listen [::]:80;
    server_name learn-anything.xyz www.learn-anything.xyz;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/learn-anything/acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://learn-anything.xyz$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    listen 127.0.0.1:8811;
    server_name learn-anything.xyz;
    ssl_certificate /etc/letsencrypt/live/learn-anything.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/learn-anything.xyz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    root /opt/learn-anything/current/public;
    index index.html;
    client_max_body_size 64k;
    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript text/javascript application/json application/xml image/svg+xml;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Learn-Anything-Origin lithuania always;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/learn-anything/acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location ~ /\. { return 404; }
    location = /_server { return 404; }
    location ^~ /_server/ { return 404; }
    location ^~ /api/ { return 404; }
    location ~ ^/(sign-in|sign-up|profile|settings|links|pages|topics|tasks|journals|onboarding|community)(/|$) { return 302 /; }
    location = /blog { return 308 /blog/; }
    location = /blog/learn-ai-image-generation { return 308 /blog/learn-ai-image-generation/; }
    location ^~ /blog/ { try_files $uri $uri/ =404; }
    location ~ ^/(robots\.txt|sitemap\.xml|blog-sitemap\.xml|favicon\.ico|favicon-\d+x\d+\.png|apple-touch-icon\.png|android-chrome-\d+x\d+\.png|logo\.png|site\.webmanifest)$ { try_files $uri =404; }
    location /_build/ { try_files $uri =404; }
    location /assets/ { try_files $uri =404; }
    location / {
        # The public site has no mutation endpoints or user sessions.
        limit_except GET HEAD { deny all; }
        proxy_pass http://127.0.0.1:8810;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_hide_header Set-Cookie;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.learn-anything.xyz;
    ssl_certificate /etc/letsencrypt/live/learn-anything.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/learn-anything.xyz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    return 301 https://learn-anything.xyz$request_uri;
}
